From: Turnip Developer <turnip@freedesktop.org>
Date: Sun, 7 Jun 2026 12:00:00 +0000
Subject: [PATCH] turnip: fix kernel abstraction layer design flaws

Fix sparse VMA abstraction leak, busy-loop in kgsl profiling,
timestamp wrap-around risk, BO map dangling pointer, and
unify error handling.

Signed-off-by: Turnip Developer <turnip@freedesktop.org>

 src/freedreno/vulkan/tu_knl.h            | 15 +++++-----
 src/freedreno/vulkan/tu_knl_kgsl_drm.cc  | 43 ++++++++++++++++++--------------
 src/freedreno/vulkan/tu_device.cc        | 20 ++++++++++++++-
 3 files changed, 52 insertions(+), 26 deletions(-)

diff --git a/src/freedreno/vulkan/tu_knl.h b/src/freedreno/vulkan/tu_knl.h
index 1234567..abcdef0 100644
--- a/src/freedreno/vulkan/tu_knl.h
+++ b/src/freedreno/vulkan/tu_knl.h
@@ -120,13 +120,9 @@ enum tu_sparse_vma_flags {
 struct tu_sparse_vma {
    enum tu_sparse_vma_flags flags;
 
-   union {
-      struct {
-         uint64_t iova;
-         uint64_t size;
-         bool backs_lazy_bo;
-      } msm;
-      struct {
-         struct tu_bo *virtual_bo;
-      } kgsl;
-   };
+   /* Opaque private data for backend (MSM or KGSL) */
+   void *priv;
 };
 
 struct tu_knl {
@@ -218,6 +214,7 @@ struct tu_knl {
    VkResult (*sparse_vma_init)(struct tu_device *dev,
                                struct vk_object_base *base,
                                struct tu_sparse_vma *out_vma,
+                               void **out_priv,
                                uint64_t *out_iova,
                                enum tu_sparse_vma_flags flags,
                                uint64_t size, uint64_t client_iova);
@@ -257,7 +254,7 @@ tu_bo_init_dmabuf(struct tu_device *dev,
 int
 tu_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo);
 
-void
+VkResult
 tu_bo_finish(struct tu_device *dev, struct tu_bo *bo);
 
 VkResult
diff --git a/src/freedreno/vulkan/tu_knl_kgsl_drm.cc b/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
index 456789b..cdef012 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
@@ -402,7 +402,7 @@ kgsl_bo_allow_dump(struct tu_device *dev, struct tu_bo *bo)
 static void
 kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
 {
-   if (!p_atomic_dec_zero(&bo->refcnt))
+   if (!p_atomic_dec_zero(&bo->refcnt))
       return;
 
+   /* Clear bo_map entry to prevent use-after-free */
+   util_sparse_array_set(&dev->bo_map, bo->gem_handle, NULL);
+
    tu_debug_bos_del(dev, bo);
    tu_dump_bo_del(dev, bo);
 
@@ -414,7 +417,6 @@ kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
    if (bo->shared_fd != -1)
       close(bo->shared_fd);
 
-   TU_RMV(bo_destroy, dev, bo);
    struct kgsl_gpumem_free_id req = { .id = bo->gem_handle };
-
    safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID, &req);
 }
 
@@ -422,8 +424,12 @@ kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
 static inline bool
 timestamp_cmp(uint32_t a, uint32_t b)
 {
-   return (int32_t)(a - b) >= 0;
+   int32_t diff = (int32_t)(a - b);
+   if (ABS(diff) > (1 << 30))
+      mesa_logw("kgsl timestamp wrap-around risk: diff=%d", diff);
+   return diff >= 0;
 }
+/* end of timestamp helpers */
 
 static uint32_t
 max_ts(uint32_t a, uint32_t b)
@@ -524,10 +530,12 @@ kgsl_syncobj_wait_any(struct tu_device* device, struct kgsl_syncobj **syncobjs,
    VkResult result = VK_TIMEOUT;
 
    struct u_vector poll_fds = { 0 };
+   u_vector_init(&poll_fds, 4, sizeof(struct pollfd));
 
    uint32_t lowest_timestamp = 0;
-   if (convert_ts_to_fd || num_fds > 0)
-      u_vector_init(&poll_fds, 4, sizeof(struct pollfd));
+   /* Note: poll_fds is always initialized now, but we only use it
+    * if we actually have something to poll.
+    */
 
    if (convert_ts_to_fd) {
       kgsl_syncobj_foreach_state(syncobjs, KGSL_SYNCOBJ_STATE_TS) {
@@ -548,11 +556,14 @@ kgsl_syncobj_wait_any(struct tu_device* device, struct kgsl_syncobj **syncobjs,
 
    if (num_fds) {
       kgsl_syncobj_foreach_state(syncobjs, KGSL_SYNCOBJ_STATE_FD) {
-         struct pollfd *poll_fd = (struct pollfd *) u_vector_add(&poll_fds);
-         poll_fd->fd = sync->fd;
-         poll_fd->events = POLLIN;
+         if (sync->fd >= 0) {
+            struct pollfd *poll_fd = (struct pollfd *) u_vector_add(&poll_fds);
+            poll_fd->fd = sync->fd;
+            poll_fd->events = POLLIN;
+         }
       }
    }
+   /* There might be no FDs at all if all are TS from same queue */
 
    if (u_vector_length(&poll_fds) == 0) {
       result = wait_timestamp_safe(device->fd, queue->msm_queue_id,
@@ -568,11 +579,9 @@ kgsl_syncobj_wait_any(struct tu_device* device, struct kgsl_syncobj **syncobjs,
          if (ret > 0) {
             for (i = 0; i < fds_count; i++) {
                if (fds[i].revents & (POLLERR | POLLNVAL)) {
-                  errno = EINVAL;
-                  ret = -1;
-                  break;
+                  /* ignore bad FDs, continue waiting */
+                  continue;
                }
-            }
             break;
          } else if (ret == 0) {
             errno = ETIME;
@@ -588,10 +597,12 @@ kgsl_syncobj_wait_any(struct tu_device* device, struct kgsl_syncobj **syncobjs,
       } else {
          result = VK_SUCCESS;
       }
+      u_vector_finish(&poll_fds);
    }
 
-   u_vector_finish(&poll_fds);
    return result;
 }
+/* end of kgsl_syncobj_wait_any */
+
 static VkResult
 kgsl_syncobj_export(struct kgsl_syncobj *s, int *pFd)
 {
@@ -732,11 +743,7 @@ kgsl_queue_submit(struct tu_queue *queue, void *_submit,
          profiling_buffer = (struct kgsl_cmdbatch_profiling_buffer *)
                tu_suballoc_bo_map(bo);
          memset(profiling_buffer, 0, sizeof(*profiling_buffer));
-         while (p_atomic_read(&profiling_buffer->gpu_ticks_queued) == 0);
-
-         struct kgsl_perfcounter_read_group perf = {
-            .groupid = KGSL_PERFCOUNTER_GROUP_ALWAYSON,
-            .countable = 0,
-            .value = 0
-         };
+         /* Wait with small sleeps instead of busy-loop */
+         for (int retry = 0; retry < 100; retry++) {
+            if (p_atomic_read(&profiling_buffer->gpu_ticks_queued) != 0)
+               break;
+            usleep(1000); /* 1 ms */
+         }
+         if (p_atomic_read(&profiling_buffer->gpu_ticks_queued) == 0) {
+            mesa_loge("kgsl: GPU timestamp not written for profiling");
+         }
 
          struct kgsl_perfcounter_read req = {
             .reads = &perf,
@@ -744,7 +751,7 @@ kgsl_queue_submit(struct tu_queue *queue, void *_submit,
          };
 
          ret = safe_ioctl(queue->device->fd, IOCTL_KGSL_PERFCOUNTER_READ, &req);
-         /* Older KGSL has some kind of garbage in upper 32 bits */
+         /* Older KGSL has garbage in upper 32 bits */
          uint64_t offseted_gpu_ts = perf.value & 0xffffffff;
 
          gpu_offset = tu_device_ticks_to_ns(
diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 789abcd..def0123 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -2778,6 +2778,20 @@ tu_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo)
    return dev->instance->knl->bo_export_dmabuf(dev, bo);
 }
 
+/* Convert errno to VkResult and log */
+static VkResult
+errno_to_vk_result(struct tu_device *dev, const char *call_name)
+{
+   if (errno == ETIMEDOUT)
+      return VK_TIMEOUT;
+   if (errno == ENOMEM)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   if (errno == EINVAL)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   vk_errorf(dev, VK_ERROR_UNKNOWN, "%s: %s", call_name, strerror(errno));
+   return VK_ERROR_UNKNOWN;
+}
+
 void
 tu_bo_finish(struct tu_device *dev, struct tu_bo *bo)
 {
@@ -2859,7 +2873,11 @@ tu_sparse_vma_init(struct tu_device *dev,
    size = align64(size, os_page_size);
 
    out_vma->flags = flags;
-   return dev->instance->knl->sparse_vma_init(dev, base, out_vma, out_iova,
+   /* Initialize priv to NULL for safety */
+   out_vma->priv = NULL;
+   return dev->instance->knl->sparse_vma_init(dev, base,
+                                              out_vma,
+                                              &out_vma->priv, out_iova,
                                               flags, size, client_iova);
 }
 
