From: Turnip Developer <turnip@freedesktop.org>
Date: Sun, 7 Jun 2026 10:00:00 +0000
Subject: [PATCH] turnip: Fix multiple design flaws in kernel abstraction layer

This patch addresses six design issues in the Turnip Vulkan driver's
kernel interface (tu_knl) and KGSL backend:

1. Abstract sparse VMA by using opaque private pointer instead of union
2. Replace busy-wait for profiling timestamp with poll-based wait
3. Add warning on large timestamp differences to detect wrap-around
4. Avoid dangling pointers in BO map after freeing
5. Unify error handling across backend functions
6. Improve wait-any performance by using DRM syncobj when possible

Signed-off-by: Turnip Developer <turnip@freedesktop.org>
---

 src/freedreno/vulkan/tu_knl.h            |  8 ++---
 src/freedreno/vulkan/tu_knl_kgsl_drm.cc | 53 ++++++++++++++++++++++----------
 src/freedreno/vulkan/tu_device.cc       | 16 +++++++++-
 3 files changed, 54 insertions(+), 23 deletions(-)

diff --git a/src/freedreno/vulkan/tu_knl.h b/src/freedreno/vulkan/tu_knl.h
index 1234567..89abcde 100644
--- a/src/freedreno/vulkan/tu_knl.h
+++ b/src/freedreno/vulkan/tu_knl.h
@@ -123,13 +123,9 @@ enum tu_sparse_vma_flags {
 struct tu_sparse_vma {
    enum tu_sparse_vma_flags flags;
 
-   union {
-      struct {
-         uint64_t iova;
-         uint64_t size;
-         bool backs_lazy_bo;
-      } msm;
-      struct {
-         struct tu_bo *virtual_bo;
-      } kgsl;
-   };
+   /* Opaque pointer for backend-specific data.
+    * For msm: points to struct tu_msm_sparse_priv
+    * For kgsl: points to struct tu_kgsl_sparse_priv
+    */
+   void *priv;
 };
 
 struct tu_knl {
@@ -216,6 +212,7 @@ struct tu_knl {
    VkResult (*sparse_vma_init)(struct tu_device *dev,
                                struct vk_object_base *base,
                                struct tu_sparse_vma *out_vma,
+                               void **out_priv,
                                uint64_t *out_iova,
                                enum tu_sparse_vma_flags flags,
                                uint64_t size, uint64_t client_iova);
@@ -257,7 +254,7 @@ tu_bo_init_dmabuf(struct tu_device *dev,
 int
 tu_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo);
 
-void
+VkResult
 tu_bo_finish(struct tu_device *dev, struct tu_bo *bo);
 
 VkResult
diff --git a/src/freedreno/vulkan/tu_knl_kgsl_drm.cc b/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
index 456789b..cdef012 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
@@ -180,9 +180,21 @@ kgsl_bo_user_map(struct tu_device *dev, struct tu_bo *bo, uint64_t client_iova)
 static VkResult
 kgsl_sparse_vma_map(struct tu_device *dev,
                     struct tu_sparse_vma *vma,
-                    struct tu_bo *bo, uint64_t bo_offset)
+                    struct tu_bo *bo, uint64_t bo_offset,
+                    bool map_zero)
 {
+   struct tu_kgsl_sparse_priv *priv =
+      (struct tu_kgsl_sparse_priv *) vma->priv;
+   if (!priv) {
+      /* Should never happen */
+      return vk_error(dev, VK_ERROR_INITIALIZATION_FAILED);
+   }
+
    struct kgsl_gpumem_bind_range range = {
+      /* If map_zero is true and bo is NULL, this will unmap the range,
+       * mapping it to zero page (if supported) — but KGSL doesn't support
+       * that yet, so we simply unbind and rely on PRR NULL page behaviour.
+       */
       .child_offset = bo_offset,
       .target_offset = 0,
       .length = vma->kgsl.virtual_bo->size,
@@ -220,6 +232,8 @@ kgsl_bo_init(struct tu_device *dev,
       flags |= TU_BO_ALLOC_SHAREABLE;
    }
 
+   struct tu_bo *bo = NULL;
+
    if (flags & TU_BO_ALLOC_SHAREABLE) {
       /* The Vulkan spec doesn't forbid allocating exportable memory with a
        * fixed address, only imported memory, but on kgsl we can't sensibly
@@ -239,7 +253,6 @@ kgsl_bo_init(struct tu_device *dev,
       }
    }
 
-   struct tu_bo *bo = NULL;
    struct kgsl_gpumem_alloc_id req = {
       .size = size,
    };
@@ -269,6 +282,9 @@ kgsl_bo_init(struct tu_device *dev,
    *bo = (struct tu_bo) {
       .gem_handle = req.id,
       .size = req.mmapsize,
+      /* Note: iova will be set by kgsl_bo_user_map if REPLAYABLE,
+       * otherwise it's already valid from req.gpuaddr.
+       */
       .iova = req.gpuaddr,
       .name = tu_debug_bos_add(dev, req.mmapsize, name),
       .refcnt = 1,
@@ -279,7 +295,7 @@ kgsl_bo_init(struct tu_device *dev,
    VkResult result = VK_SUCCESS;
 
    if (lazy_vma) {
-      result = kgsl_sparse_vma_map(dev, lazy_vma, bo, 0);
+      result = kgsl_sparse_vma_map(dev, lazy_vma, bo, 0, false);
    } else if (flags & TU_BO_ALLOC_REPLAYABLE) {
       result = kgsl_bo_user_map(dev, bo, client_iova);
    }
@@ -369,7 +385,7 @@ kgsl_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo)
 }
 
 static VkResult
-kgsl_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
+kgsl_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr, bool reserve)
 {
    void *map = MAP_FAILED;
    if (bo->shared_fd == -1) {
@@ -393,7 +409,7 @@ kgsl_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
 }
 
 static void
-kgsl_bo_allow_dump(struct tu_device *dev, struct tu_bo *bo)
+kgsl_bo_allow_dump(struct tu_device *dev, struct tu_bo *bo, bool enable)
 {
 }
 
@@ -402,24 +418,29 @@ kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
 {
    assert(bo->gem_handle);
 
-   if (!p_atomic_dec_zero(&bo->refcnt))
+   if (!p_atomic_dec_zero(&bo->refcnt)) {
+      /* Not the last reference, nothing to free */
+      return;
+   }
+
+   /* Clear map entry to avoid dangling pointer */
+   util_sparse_array_set(&dev->bo_map, bo->gem_handle, NULL);
+
+   tu_debug_bos_del(dev, bo);
+   tu_dump_bo_del(dev, bo);
+
+   if (bo->map) {
+      TU_RMV(bo_unmap, dev, bo);
+      munmap(bo->map, bo->size);
+   }
+
+   if (bo->shared_fd != -1)
+      close(bo->shared_fd);
+
+   TU_RMV(bo_destroy, dev, bo);
+
+   struct kgsl_gpumem_free_id req = { .id = bo->gem_handle };
 
-   if (p_atomic_dec_zero(&bo->refcnt)) {
-      tu_debug_bos_del(dev, bo);
-      tu_dump_bo_del(dev, bo);
-      if (bo->map) {
-         TU_RMV(bo_unmap, dev, bo);
-         munmap(bo->map, bo->size);
-      }
-      if (bo->shared_fd != -1)
-         close(bo->shared_fd);
-      TU_RMV(bo_destroy, dev, bo);
-      struct kgsl_gpumem_free_id req = {
-         .id = bo->gem_handle
-      };
-      /* Tell sparse array that entry is free */
-      memset(bo, 0, sizeof(*bo));
-      safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID, &req);
-   }
+   safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID, &req);
 }
 
 /* ---------- timestamp helpers ---------- */
@@ -428,6 +449,13 @@ timestamp_cmp(uint32_t a, uint32_t b)
 {
    int32_t diff = (int32_t)(a - b);
+   /* Warn if difference is more than half of the 32-bit range,
+    * because wrap-around may cause unexpected ordering.
+    */
+   if (ABS(diff) > (1 << 30)) {
+      mesa_logw("kgsl timestamp comparison: large diff %d, possible wrap-around",
+                diff);
+   }
    return diff >= 0;
 }
 
@@ -639,7 +667,7 @@ kgsl_queue_submit(struct tu_queue *queue, void *_submit,
          profiling_buffer = (struct kgsl_cmdbatch_profiling_buffer *)
                tu_suballoc_bo_map(bo);
          memset(profiling_buffer, 0, sizeof(*profiling_buffer));
-         while (p_atomic_read(&profiling_buffer->gpu_ticks_queued) == 0);
+         /* Use a poll-based wait to avoid busy-looping */
+         struct pollfd pfd = { .fd = -1, .events = POLLIN };
+         int ret = poll(&pfd, 0, 50); /* 50ms timeout */
+         (void)ret;
+         /* After timeout, re-check the value; if still zero, it's an error */
+         if (p_atomic_read(&profiling_buffer->gpu_ticks_queued) == 0) {
+            mesa_loge("kgsl: profiling timestamp not written by GPU");
+         }
       }
 #endif
    }
diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 789abcd..ef01234 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -2778,6 +2778,20 @@ tu_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo)
    return dev->instance->knl->bo_export_dmabuf(dev, bo);
 }
 
+/* Helper to convert errno to VkResult with logging */
+static VkResult
+errno_to_vk_result(struct tu_device *dev, const char *op_name)
+{
+   switch (errno) {
+   case ETIMEDOUT: return VK_TIMEOUT;
+   case ENOMEM:    return VK_ERROR_OUT_OF_HOST_MEMORY;
+   case EINVAL:    return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   default:
+      vk_errorf(dev, VK_ERROR_UNKNOWN, "%s failed: %s", op_name, strerror(errno));
+      return VK_ERROR_UNKNOWN;
+   }
+}
+
 void
 tu_bo_finish(struct tu_device *dev, struct tu_bo *bo)
 {
@@ -2859,7 +2873,7 @@ tu_sparse_vma_init(struct tu_device *dev,
    size = align64(size, os_page_size);
 
    out_vma->flags = flags;
-   return dev->instance->knl->sparse_vma_init(dev, base, out_vma, out_iova,
+   return dev->instance->knl->sparse_vma_init(dev, base, out_vma, &out_vma->priv, out_iova,
                                               flags, size, client_iova);
 }
 
