@@ -304,7 +304,7 @@ kgsl_bo_export_dmabuf(struct tu_device *dev, struct tu_bo *bo)
 }
 
 static VkResult
 kgsl_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
 {
@@ -477,6 +477,8 @@ kgsl_syncobj_export(struct kgsl_syncobj *s, int *pFd)
    if (!pFd)
       return VK_SUCCESS;
 
+   /* If the syncobj is unsignaled, we can still export a fence that will signal later */
    switch (s->state) {
    case KGSL_SYNCOBJ_STATE_SIGNALED:
    case KGSL_SYNCOBJ_STATE_UNSIGNALED:
@@ -506,6 +508,7 @@ kgsl_syncobj_import(struct kgsl_syncobj *s, int fd)
    kgsl_syncobj_reset(s);
    if (fd >= 0) {
       s->state = KGSL_SYNCOBJ_STATE_FD;
       s->fd = fd;
diff --git a/src/freedreno/vulkan/tu_wsi.cc b/src/freedreno/vulkan/tu_wsi.cc
index 123abc..456def 100644
--- a/src/freedreno/vulkan/tu_wsi.cc
+++ b/src/freedreno/vulkan/tu_wsi.cc
@@ -52,17 +52,30 @@ tu_wsi_init(struct tu_physical_device *physical_device)
 {
    VkResult result;
 
    const struct wsi_device_options options = { .sw_device = false };
+   /* KGSL does not have a DRM master node; we must skip DRM-based WSI.
+      However, external memory and sync extensions remain functional. */
+   if (tu_wsi_is_kgsl(physical_device)) {
+      /* Initialize a minimal WSI device that doesn't depend on DRM */
+      result = wsi_device_init(&physical_device->wsi_device,
+                               tu_physical_device_to_handle(physical_device),
+                               tu_wsi_proc_addr,
+                               &physical_device->instance->vk.alloc,
+                               -1, /* no DRM fd */
+                               &physical_device->instance->drirc.options,
+                               &options);
+   } else {
    result = wsi_device_init(&physical_device->wsi_device,
                             tu_physical_device_to_handle(physical_device),
                             tu_wsi_proc_addr,
                             &physical_device->instance->vk.alloc,
                             physical_device->master_fd,
                             &physical_device->instance->drirc.options,
                             &options);
+   }
    if (result != VK_SUCCESS)
       return result;
 
    physical_device->wsi_device.supports_modifiers = true;
    physical_device->wsi_device.can_present_on_device =
       tu_wsi_can_present_on_device;
