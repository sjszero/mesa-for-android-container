@@ -1266,7 +1266,15 @@ tu_physical_device_init(struct tu_physical_device *device,
    device->memory.types[0] =
       VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
       VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+      VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+
+   /* Workaround for weston vulkan-renderer: add a memory type with only
