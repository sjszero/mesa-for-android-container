@@ -0,0 +1,50 @@
+/*
+ * Copyright © 2025 The Mesa Authors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef TU_WSI_DAEMON_H
+#define TU_WSI_DAEMON_H
+
+#include <vulkan/vulkan.h>
+#include "tu_common.h"
+
+/* Metadata sent to display daemon per image */
+struct tu_wsi_daemon_metadata {
+   uint32_t width;
+   uint32_t height;
+   uint32_t format;      /* VkFormat */
+   uint32_t stride;      /* bytes per row */
+};
+
+/* Functions called from tu_wsi.c */
+void tu_wsi_daemon_init(struct tu_physical_device *pdevice);
+void tu_wsi_daemon_finish(struct tu_physical_device *pdevice);
+
+/* Called by the swapchain implementation */
+VkResult tu_wsi_daemon_create_swapchain(VkDevice device,
+                                        const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                        const VkAllocationCallbacks *pAllocator,
+                                        VkSwapchainKHR *pSwapchain);
+void tu_wsi_daemon_destroy_swapchain(VkDevice device, VkSwapchainKHR swapchain,
+                                     const VkAllocationCallbacks *pAllocator);
+VkResult tu_wsi_daemon_acquire_next_image(VkDevice device, VkSwapchainKHR swapchain,
+                                          uint64_t timeout, VkSemaphore semaphore,
+                                          VkFence fence, uint32_t *pImageIndex);
+VkResult tu_wsi_daemon_queue_present(VkQueue queue, uint32_t queueFamilyIndex,
+                                     const VkPresentInfoKHR *pPresentInfo);
+
+/* Helper to get the daemon socket fd from physical device */
+static inline int
+tu_wsi_daemon_get_fd(struct tu_physical_device *pdevice)
+{
+   return pdevice->display_daemon_fd;
+}
+
+/* Check if daemon WSI is enabled */
+static inline bool
+tu_wsi_daemon_enabled(struct tu_physical_device *pdevice)
+{
+   return pdevice->display_daemon_fd >= 0;
+}
+
+#endif /* TU_WSI_DAEMON_H */
diff --git a/src/freedreno/vulkan/tu_wsi_daemon.cc b/src/freedreno/vulkan/tu_wsi_daemon.cc
new file mode 100644
index 0000000..abcdefg
--- /dev/null
+++ b/src/freedreno/vulkan/tu_wsi_daemon.cc
@@ -0,0 +1,399 @@
+/*
+ * Copyright © 2025 The Mesa Authors
+ * SPDX-License-Identifier: MIT
+ *
+ * WSI platform for display daemon (cross-container display)
+ */
+
+#include "tu_wsi_daemon.h"
+#include "tu_device.h"
+#include "tu_knl.h"
+#include "tu_queue.h"
+#include "vk_android.h"
+#include "vk_common_entrypoints.h"
+#include "vk_util.h"
+#include "util/u_debug.h"
+#include "util/os_time.h"
+#include "util/u_vector.h"
+
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <poll.h>
+
+#define TU_WSI_DAEMON_PROTOCOL_VERSION 1
+
+/* Protocol message types */
+enum tu_wsi_daemon_msg_type {
+   TU_WSI_DAEMON_MSG_HANDSHAKE,
+   TU_WSI_DAEMON_MSG_SWAPCHAIN_CREATE,
+   TU_WSI_DAEMON_MSG_SWAPCHAIN_DESTROY,
+   TU_WSI_DAEMON_MSG_ACQUIRE_IMAGE,
+   TU_WSI_DAEMON_MSG_PRESENT,
+   TU_WSI_DAEMON_MSG_IMAGE_METADATA,
+};
+
+struct tu_wsi_daemon_msg_hdr {
+   uint32_t type;
+   uint32_t size;  /* size of payload */
+   uint32_t seqno; /* for matching responses */
+};
+
+struct tu_wsi_daemon_handshake {
+   uint32_t version;
+   uint32_t pid;
+};
+
+struct tu_wsi_daemon_swapchain_info {
+   uint32_t width;
+   uint32_t height;
+   uint32_t image_count;
+   uint32_t format;   /* VkFormat */
+   uint32_t present_mode; /* VkPresentModeKHR */
+};
+
+struct tu_wsi_daemon_swapchain_reply {
+   uint32_t swapchain_id;
+   uint32_t image_count;
+};
+
+struct tu_wsi_daemon_acquire_reply {
+   uint32_t image_index;
+   int32_t  fence_fd; /* dma-buf fence fd, -1 if none */
+};
+
+/* Per-swapchain data */
+struct tu_wsi_daemon_swapchain {
+   struct vk_object_base base;
+   VkDevice device;
+   uint32_t swapchain_id;
+   uint32_t image_count;
+   struct tu_bo **images;   /* exported dma-buf BOs */
+   uint32_t *image_fds;
+   VkImage *vk_images;
+   VkImageView *image_views;
+   VkExtent2D extent;
+   VkFormat format;
+   bool use_fence_sync;
+};
+
+static void
+tu_wsi_daemon_send_msg(int fd, uint32_t type, const void *payload, size_t payload_size, uint32_t seqno)
+{
+   struct tu_wsi_daemon_msg_hdr hdr = {
+      .type = type,
+      .size = payload_size,
+      .seqno = seqno,
+   };
+   struct iovec iov[2] = {
+      { &hdr, sizeof(hdr) },
+      { (void *)payload, payload_size },
+   };
+   ssize_t ret = writev(fd, iov, payload_size ? 2 : 1);
+   if (ret < 0)
+      mesa_loge("tu_wsi_daemon: send failed: %s", strerror(errno));
+}
+
+static ssize_t
+tu_wsi_daemon_recv_msg(int fd, struct tu_wsi_daemon_msg_hdr *hdr, void *payload, size_t max_payload)
+{
+   ssize_t ret = read(fd, hdr, sizeof(*hdr));
+   if (ret != sizeof(*hdr))
+      return -1;
+   if (hdr->size > max_payload)
+      return -1;
+   if (hdr->size) {
+      ret = read(fd, payload, hdr->size);
+      if (ret != (ssize_t)hdr->size)
+         return -1;
+   }
+   return ret;
+}
+
+void
+tu_wsi_daemon_init(struct tu_physical_device *pdevice)
+{
+   const char *socket_path = getenv("TU_DISPLAY_DAEMON_SOCKET");
+   if (!socket_path) {
+      pdevice->display_daemon_fd = -1;
+      pdevice->has_daemon_wsi = false;
+      return;
+   }
+
+   int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+   if (fd < 0) {
+      mesa_loge("Failed to create daemon socket: %s", strerror(errno));
+      pdevice->display_daemon_fd = -1;
+      pdevice->has_daemon_wsi = false;
+      return;
+   }
+
+   struct sockaddr_un addr = {
+      .sun_family = AF_UNIX,
+   };
+   strncpy(addr.sun_path, socket_path, sizeof(addr.sun_path) - 1);
+   if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+      mesa_loge("Failed to connect to display daemon at %s: %s", socket_path, strerror(errno));
+      close(fd);
+      pdevice->display_daemon_fd = -1;
+      pdevice->has_daemon_wsi = false;
+      return;
+   }
+
+   /* Send handshake */
+   struct tu_wsi_daemon_handshake hs = {
+      .version = TU_WSI_DAEMON_PROTOCOL_VERSION,
+      .pid = getpid(),
+   };
+   tu_wsi_daemon_send_msg(fd, TU_WSI_DAEMON_MSG_HANDSHAKE, &hs, sizeof(hs), 0);
+
+   /* Wait for reply (simple ack) */
+   struct tu_wsi_daemon_msg_hdr reply_hdr;
+   uint8_t dummy[8];
+   ssize_t ret = tu_wsi_daemon_recv_msg(fd, &reply_hdr, dummy, sizeof(dummy));
+   if (ret < 0 || reply_hdr.type != TU_WSI_DAEMON_MSG_HANDSHAKE) {
+      mesa_loge("Display daemon handshake failed");
+      close(fd);
+      pdevice->display_daemon_fd = -1;
+      pdevice->has_daemon_wsi = false;
+      return;
+   }
+
+   pdevice->display_daemon_fd = fd;
+   pdevice->has_daemon_wsi = true;
+   mesa_logi("Connected to display daemon at %s", socket_path);
+}
+
+void
+tu_wsi_daemon_finish(struct tu_physical_device *pdevice)
+{
+   if (pdevice->display_daemon_fd >= 0) {
+      close(pdevice->display_daemon_fd);
+      pdevice->display_daemon_fd = -1;
+   }
+   pdevice->has_daemon_wsi = false;
+}
+
+static VkResult
+tu_wsi_daemon_create_swapchain_images(struct tu_device *dev,
+                                      struct tu_wsi_daemon_swapchain *swapchain,
+                                      uint32_t count, VkExtent2D extent, VkFormat format)
+{
+   VkResult result = VK_SUCCESS;
+   swapchain->image_count = count;
+   swapchain->images = (struct tu_bo **)vk_alloc(&dev->vk.alloc, count * sizeof(struct tu_bo *), 8,
+                                                 VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   swapchain->image_fds = (uint32_t *)vk_alloc(&dev->vk.alloc, count * sizeof(uint32_t), 8,
+                                               VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   swapchain->vk_images = (VkImage *)vk_alloc(&dev->vk.alloc, count * sizeof(VkImage), 8,
+                                              VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   swapchain->image_views = (VkImageView *)vk_alloc(&dev->vk.alloc, count * sizeof(VkImageView), 8,
+                                                    VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!swapchain->images || !swapchain->image_fds || !swapchain->vk_images || !swapchain->image_views)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   for (uint32_t i = 0; i < count; i++) {
+      /* Allocate dma-buf via normal tu_bo allocation, then export fd.
+       * We'll send the fd to daemon along with metadata.
+       */
+      uint64_t size = extent.width * extent.height * 4; /* RGBA8 */
+      result = tu_bo_init_new(dev, &swapchain->base, &swapchain->images[i], size,
+                              TU_BO_ALLOC_SHAREABLE | TU_BO_ALLOC_ALLOW_DUMP,
+                              "daemon_wsi_image");
+      if (result != VK_SUCCESS)
+         goto fail;
+
+      int fd = tu_bo_export_dmabuf(dev, swapchain->images[i]);
+      if (fd < 0) {
+         result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+         goto fail;
+      }
+      swapchain->image_fds[i] = fd;
+
+      /* Store image metadata in BO for later export */
+      swapchain->images[i]->image_width = extent.width;
+      swapchain->images[i]->image_height = extent.height;
+      swapchain->images[i]->image_format = format;
+      swapchain->images[i]->image_stride = extent.width * 4;
+
+      /* Send metadata to daemon */
+      struct tu_wsi_daemon_metadata meta = {
+         .width = extent.width,
+         .height = extent.height,
+         .format = format,
+         .stride = extent.width * 4,
+      };
+      tu_wsi_daemon_send_msg(dev->physical_device->display_daemon_fd,
+                             TU_WSI_DAEMON_MSG_IMAGE_METADATA,
+                             &meta, sizeof(meta), i);
+   }
+   return VK_SUCCESS;
+
+fail:
+   for (uint32_t j = 0; j < i; j++) {
+      if (swapchain->image_fds[j] >= 0)
+         close(swapchain->image_fds[j]);
+      tu_bo_finish(dev, swapchain->images[j]);
+   }
+   vk_free(&dev->vk.alloc, swapchain->images);
+   vk_free(&dev->vk.alloc, swapchain->image_fds);
+   vk_free(&dev->vk.alloc, swapchain->vk_images);
+   vk_free(&dev->vk.alloc, swapchain->image_views);
+   return result;
+}
+
+VkResult
+tu_wsi_daemon_create_swapchain(VkDevice _device,
+                               const VkSwapchainCreateInfoKHR *pCreateInfo,
+                               const VkAllocationCallbacks *pAllocator,
+                               VkSwapchainKHR *_pSwapchain)
+{
+   VK_FROM_HANDLE(tu_device, dev, _device);
+   if (!dev->daemon_wsi_enabled)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   struct tu_wsi_daemon_swapchain *swapchain = (struct tu_wsi_daemon_swapchain *)
+      vk_object_zalloc(&dev->vk, pAllocator, sizeof(*swapchain), VK_OBJECT_TYPE_SWAPCHAIN_KHR);
+   if (!swapchain)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   swapchain->device = _device;
+   swapchain->extent = pCreateInfo->imageExtent;
+   swapchain->format = pCreateInfo->imageFormat;
+   swapchain->use_fence_sync = !!(pCreateInfo->flags & VK_SWAPCHAIN_CREATE_DEFERRED_MEMORY_ALLOCATION_BIT_EXT);
+
+   /* Send swapchain creation request to daemon */
+   struct tu_wsi_daemon_swapchain_info info = {
+      .width = pCreateInfo->imageExtent.width,
+      .height = pCreateInfo->imageExtent.height,
+      .image_count = pCreateInfo->minImageCount,
+      .format = pCreateInfo->imageFormat,
+      .present_mode = pCreateInfo->presentMode,
+   };
+   uint32_t seqno = 1; /* simple */
+   tu_wsi_daemon_send_msg(dev->physical_device->display_daemon_fd,
+                          TU_WSI_DAEMON_MSG_SWAPCHAIN_CREATE,
+                          &info, sizeof(info), seqno);
+
+   /* Wait for reply */
+   struct tu_wsi_daemon_msg_hdr reply;
+   struct tu_wsi_daemon_swapchain_reply reply_payload;
+   ssize_t ret = tu_wsi_daemon_recv_msg(dev->physical_device->display_daemon_fd,
+                                        &reply, &reply_payload, sizeof(reply_payload));
+   if (ret < 0 || reply.type != TU_WSI_DAEMON_MSG_SWAPCHAIN_CREATE) {
+      vk_object_free(&dev->vk, pAllocator, swapchain);
+      return VK_ERROR_DEVICE_LOST;
+   }
+
+   swapchain->swapchain_id = reply_payload.swapchain_id;
+   uint32_t image_count = reply_payload.image_count;
+
+   /* Create backing images */
+   VkResult result = tu_wsi_daemon_create_swapchain_images(dev, swapchain, image_count,
+                                                           swapchain->extent, swapchain->format);
+   if (result != VK_SUCCESS) {
+      vk_object_free(&dev->vk, pAllocator, swapchain);
+      return result;
+   }
+
+   *_pSwapchain = tu_swapchain_to_handle(swapchain);
+   return VK_SUCCESS;
+}
+
+void
+tu_wsi_daemon_destroy_swapchain(VkDevice _device, VkSwapchainKHR _swapchain,
+                                const VkAllocationCallbacks *pAllocator)
+{
+   VK_FROM_HANDLE(tu_wsi_daemon_swapchain, swapchain, _swapchain);
+   VK_FROM_HANDLE(tu_device, dev, _device);
+
+   /* Notify daemon */
+   tu_wsi_daemon_send_msg(dev->physical_device->display_daemon_fd,
+                          TU_WSI_DAEMON_MSG_SWAPCHAIN_DESTROY,
+                          &swapchain->swapchain_id, sizeof(swapchain->swapchain_id), 0);
+
+   for (uint32_t i = 0; i < swapchain->image_count; i++) {
+      if (swapchain->image_fds[i] >= 0)
+         close(swapchain->image_fds[i]);
+      tu_bo_finish(dev, swapchain->images[i]);
+   }
+   vk_free(&dev->vk.alloc, swapchain->images);
+   vk_free(&dev->vk.alloc, swapchain->image_fds);
+   vk_free(&dev->vk.alloc, swapchain->vk_images);
+   vk_free(&dev->vk.alloc, swapchain->image_views);
+   vk_object_free(&dev->vk, pAllocator, swapchain);
+}
+
+VkResult
+tu_wsi_daemon_acquire_next_image(VkDevice _device, VkSwapchainKHR _swapchain,
+                                 uint64_t timeout, VkSemaphore semaphore,
+                                 VkFence fence, uint32_t *pImageIndex)
+{
+   VK_FROM_HANDLE(tu_wsi_daemon_swapchain, swapchain, _swapchain);
+   VK_FROM_HANDLE(tu_device, dev, _device);
+
+   /* Simple implementation: just return the next image index in round-robin.
+    * In a full implementation, we would send a request to daemon and wait for
+    * a fence fd or use semaphore.
+    */
+   static uint32_t next_index = 0;
+   *pImageIndex = next_index % swapchain->image_count;
+   next_index++;
+
+   /* Simulate presentation fence: we don't have real fence from daemon,
+    * so we signal the semaphore/fence immediately.
+    */
+   if (semaphore != VK_NULL_HANDLE) {
+      VkResult result = tu_QueueSubmit(tu_queue_from_handle(dev->queues[0][0]), 0, NULL, semaphore);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   if (fence != VK_NULL_HANDLE) {
+      VkResult result = tu_QueueSubmit(tu_queue_from_handle(dev->queues[0][0]), 0, NULL, fence);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   return VK_SUCCESS;
+}
+
+VkResult
+tu_wsi_daemon_queue_present(VkQueue _queue, uint32_t queueFamilyIndex,
+                            const VkPresentInfoKHR *pPresentInfo)
+{
+   VK_FROM_HANDLE(tu_queue, queue, _queue);
+   struct tu_device *dev = queue->device;
+   if (!dev->daemon_wsi_enabled)
+      return VK_ERROR_DEVICE_LOST;
+
+   for (uint32_t i = 0; i < pPresentInfo->swapchainCount; i++) {
+      VK_FROM_HANDLE(tu_wsi_daemon_swapchain, swapchain, pPresentInfo->pSwapchains[i]);
+      uint32_t image_index = pPresentInfo->pImageIndices[i];
+
+      /* Send present request to daemon, including the dma-buf fd for this image */
+      int fd = swapchain->image_fds[image_index];
+      if (fd < 0) {
+         mesa_loge("Invalid image fd for present");
+         continue;
+      }
+      struct msghdr msg = {0};
+      struct cmsghdr *cmsg;
+      char buf[CMSG_SPACE(sizeof(int))];
+      memset(buf, 0, sizeof(buf));
+      msg.msg_control = buf;
+      msg.msg_controllen = sizeof(buf);
+      cmsg = CMSG_FIRSTHDR(&msg);
+      cmsg->cmsg_level = SOL_SOCKET;
+      cmsg->cmsg_type = SCM_RIGHTS;
+      cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+      *(int *)CMSG_DATA(cmsg) = os_dupfd_cloexec(fd);
+      /* Send a dummy byte with the fd */
+      uint8_t dummy = 0;
+      struct iovec iov = { &dummy, 1 };
+      msg.msg_iov = &iov;
+      msg.msg_iovlen = 1;
+      ssize_t ret = sendmsg(dev->physical_device->display_daemon_fd, &msg, 0);
+      if (ret < 0)
+         mesa_loge("Failed to send image fd to daemon: %s", strerror(errno));
+   }
+   return VK_SUCCESS;
+}
