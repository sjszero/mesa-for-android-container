diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index e1bbd3d..af42b9c 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -386,8 +386,8 @@ static void get_device_extensions(const struct tu_physical_device *device,
 
       /* For Graphics Flight Recorder (GFR) */
       .AMD_buffer_marker = true,
-      .ANDROID_external_memory_android_hardware_buffer = has_gralloc,
-      .ANDROID_native_buffer = has_gralloc,
+      .ANDROID_external_memory_android_hardware_buffer = true,
+      .ANDROID_native_buffer = true,
       .ARM_rasterization_order_attachment_access = true,
       .GOOGLE_decorate_string = true,
 #ifdef TU_USE_WSI_PLATFORM
@@ -3156,7 +3156,19 @@ tu_CreateDevice(VkPhysicalDevice physicalDevice,
    device->use_z24uint_s8uint =
       physical_device->info->props.has_z24uint_s8uint &&
       (!border_color_without_format ||
        !physical_device->instance->drirc.misc.enable_d24s8_border_color_workaround);
-   device->use_lrz = !TU_DEBUG_START(NOLRZ);
+   /* Multi-Adreno compatibility: disable certain features on non-840 7xx chips
+    * to avoid AHB bus errors seen on Adreno 750. */
+   bool is_kgsl = (strcmp(physical_device->instance->knl->name, "kgsl") == 0);
+   uint32_t gpu_id = physical_device->dev_id.gpu_id;
+   bool is_problematic_7xx = is_kgsl && (gpu_id >= 700 && gpu_id < 800 && gpu_id != 840);
+   if (is_problematic_7xx) {
+      mesa_logi("TU: applying workarounds for Adreno %u (non-840 7xx)", gpu_id);
+      device->use_lrz = false;                 /* disable LRZ */
+      device->use_z24uint_s8uint = false;      /* fallback to other depth formats */
+   } else {
+      device->use_lrz = !TU_DEBUG_START(NOLRZ);
+   }
+
 
    tu_gpu_tracepoint_config_variable();
@@ -3463,6 +3480,23 @@ tu_GetInstanceProcAddr(VkInstance _instance, const char *pName)
                                     pName);
 }
 
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+tu_GetDeviceProcAddr(VkDevice _device, const char *pName)
+{
+   VK_FROM_HANDLE(tu_device, device, _device);
+   return vk_device_get_proc_addr(&device->vk, pName);
+}
+
+/* Required ICD entrypoint for the loader */
+PUBLIC VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vk_icdGetDeviceProcAddr(VkDevice device, const char *pName);
+
+PUBLIC VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vk_icdGetDeviceProcAddr(VkDevice device, const char *pName)
+{
+   return tu_GetDeviceProcAddr(device, pName);
+}
+
 /* The loader wants us to expose a second GetInstanceProcAddr function
  * to work around certain LD_PRELOAD issues seen in apps.
  */
