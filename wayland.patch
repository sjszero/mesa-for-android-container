diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index e1bbd3d..c8d9e0f 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -2117,7 +2117,16 @@ tu_GetPhysicalDeviceMemoryProperties2(VkPhysicalDevice pdev,
          .propertyFlags = physical_device->memory.types[i],
          .heapIndex     = 0,
       };
+
+   /* Override heap size to 2GB to avoid Weston thinking it's out of memory */
+   props->memoryHeaps[0].size = 2ull << 30;
+
+   /* Mark all memory types as device-local and host-visible */
+   for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+      props->memoryTypes[i].propertyFlags |= VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
+                                              VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+   }
    }
 
    vk_foreach_struct(ext, props2->pNext)
    {
@@ -3460,6 +3469,23 @@ tu_GetInstanceProcAddr(VkInstance _instance, const char *pName)
                                     pName);
 }
 
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+tu_GetDeviceProcAddr(VkDevice _device, const char *pName)
+{
+   VK_FROM_HANDLE(tu_device, device, _device);
+   return vk_device_get_proc_addr(&device->vk, pName);
+}
+
+/* Required ICD entrypoint for the loader */
+PUBLIC VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vk_icdGetDeviceProcAddr(VkDevice device, const char *pName);
+
+PUBLIC VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vk_icdGetDeviceProcAddr(VkDevice device, const char *pName)
+{
+   return tu_GetDeviceProcAddr(device, pName);
+}
+
 /* The loader wants us to expose a second GetInstanceProcAddr function
  * to work around certain LD_PRELOAD issues seen in apps.
  */
@@ -3625,9 +3660,14 @@ tu_AllocateMemory(VkDevice _device,
    struct tu_device_memory *mem;
    VkResult result;
 
+   if (TU_DEBUG(STARTUP))
+      mesa_logi("AllocateMemory: size=%lu, memoryTypeIndex=%u",
+                (unsigned long)pAllocateInfo->allocationSize,
+                pAllocateInfo->memoryTypeIndex);
+
    assert(pAllocateInfo->sType == VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO);
 
    struct tu_memory_heap *mem_heap = &device->physical_device->heap;
    uint64_t mem_heap_used = p_atomic_read(&mem_heap->used);
    if (mem_heap_used > mem_heap->size)
       return vk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
@@ -3686,10 +3723,16 @@ tu_AllocateMemory(VkDevice _device,
       result = tu_bo_init_dmabuf(device, &mem->bo, size, alloc_flags,
                                  handle->data[0]);
 #else
       result = VK_ERROR_FEATURE_NOT_PRESENT;
 #endif
    } else {
+      /* For non-dmabuf allocations, ensure we use cached-coherent memory if available */
+      if (device->physical_device->has_cached_coherent_memory &&
+          !(mem_property & VK_MEMORY_PROPERTY_HOST_CACHED_BIT)) {
+         mem_property |= VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+      }
+
       uint64_t client_address = 0;
 
       const VkMemoryOpaqueCaptureAddressAllocateInfo *replay_info =
          vk_find_struct_const(pAllocateInfo->pNext,
@@ -4401,11 +4437,16 @@ tu_GetMemoryFdPropertiesKHR(VkDevice _device,
 {
    VK_FROM_HANDLE(tu_device, device, _device);
    assert(handleType == VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT);
-   pMemoryFdProperties->memoryTypeBits =
-      (1 << device->physical_device->memory.non_lazy_type_count) - 1;
+
+   /* Return all memory types (including lazy) to maximise compatibility */
+   pMemoryFdProperties->memoryTypeBits = (1 << device->physical_device->memory.type_count) - 1;
+
+   if (TU_DEBUG(STARTUP))
+      mesa_logi("GetMemoryFdProperties: handleType=0x%x, fd=%d, memoryTypeBits=0x%x",
+                handleType, fd, pMemoryFdProperties->memoryTypeBits);
    return VK_SUCCESS;
 }
 
 VKAPI_ATTR void VKAPI_CALL
 tu_GetPhysicalDeviceMemoryProperties2(VkPhysicalDevice pdev,
                                       VkPhysicalDeviceMemoryProperties2 *props2)
diff --git a/src/freedreno/vulkan/tu_image.cc b/src/freedreno/vulkan/tu_image.cc
index 5a4b3c2..e8f9a1b 100644
--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -678,18 +678,41 @@ tu_image_init(struct tu_device *device, struct tu_image *image,
    if (force_linear_tile) {
       tile_mode = TILE6_LINEAR;
       ubwc_enabled = false;
    }
 
+   /* If this image is being created from an external buffer (dma-buf or Android
+    * native buffer), force linear tiling and disable UBWC to maximise compatibility.
+    * The Android allocator may not produce UBWC-compatible layouts.
+    */
+   if (modifier == DRM_FORMAT_MOD_LINEAR ||
+       modifier == DRM_FORMAT_MOD_INVALID ||
+       image->vk.external_handle_types != 0 ||
+       vk_image_is_android_native_buffer(&image->vk)) {
+      if (TU_DEBUG(STARTUP)) {
+         mesa_logi("Forcing linear tiling and disabling UBWC for imported buffer");
+      }
+      force_linear_tile = true;
+      ubwc_enabled = false;
+   }
+
+   /* Additionally, if the image is being created with DRM format modifier list
+    * and the only modifier is LINEAR, force linear tiling.
+    */
+   if (modifier == DRM_FORMAT_MOD_LINEAR) {
+      force_linear_tile = true;
+      ubwc_enabled = false;
+   }
+
    /* Whether a view of the image with an R8G8 format could be made. */
    bool has_r8g8 = tu_is_r8g8(vk_format_to_pipe_format(image->vk.format));
 
    /* With AHB, we could be asked to create an image with VK_IMAGE_TILING_LINEAR
     * but gralloc doesn't know this.  So if we are explicitly told that it is
     * UBWC, then override how the image was created.
     */
    bool force_ubwc = false;
    if (modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED) {
       assert(!force_linear_tile);
       ubwc_enabled = true;
       force_ubwc = true;
    }
diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 7c8d9e0..f2e3d4c 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -383,20 +383,35 @@ static VkResult
 kgsl_bo_init_dmabuf(struct tu_device *dev,
                     struct tu_bo **out_bo,
                     uint64_t size,
                     enum tu_bo_alloc_flags flags,
                     int fd)
 {
+   /* If size is 0 or unaligned, get the actual size from the fd */
+   if (size == 0 || (size & (os_page_size - 1)) != 0) {
+      off_t file_size = lseek(fd, 0, SEEK_END);
+      if (file_size > 0) {
+         size = align64(file_size, os_page_size);
+         if (TU_DEBUG(STARTUP))
+            mesa_logi("dma-buf import: corrected size from fd to %ld",
+                      (long)file_size);
+      } else {
+         size = MAX2(size, 4096);
+         size = align64(size, os_page_size);
+      }
+   }
+
    struct kgsl_gpuobj_import_dma_buf import_dmabuf = {
       .fd = fd,
    };
    struct kgsl_gpuobj_import req = {
       .priv = (uintptr_t)&import_dmabuf,
       .priv_len = sizeof(import_dmabuf),
+      /* Force linear mapping and disable UBWC-related flags */
       .flags = 0,
       .type = KGSL_USER_MEM_TYPE_DMABUF,
    };
    int ret;
 
    ret = safe_ioctl(dev->physical_device->local_fd,
                     IOCTL_KGSL_GPUOBJ_IMPORT, &req);
    if (ret)
@@ -417,25 +432,33 @@ kgsl_bo_init_dmabuf(struct tu_device *dev,
    assert(bo && bo->gem_handle == 0);
 
    *bo = (struct tu_bo) {
       .gem_handle = req.id,
-      .size = info_req.size,
+      .size = MAX2(info_req.size, size),
       .iova = info_req.gpuaddr,
+      /* Mark this BO as never unmapped and always cached coherent */
+      .never_unmap = true,
+      .cached_non_coherent = false,
       .name = tu_debug_bos_add(dev, info_req.size, "dmabuf"),
       .refcnt = 1,
       .shared_fd = os_dupfd_cloexec(fd),
    };
 
    struct stat st;
    if (fstat(fd, &st) == 0)
       /* Use the inode number as the unique ID, but set the MSB to avoid
        * collisions with 32-bit KGSL handles (which are used for native BOs).
        */
       bo->unique_id = st.st_ino | (1ULL << 63);
 
+   if (TU_DEBUG(STARTUP))
+      mesa_logi("Imported dma-buf: gem_handle=%u, size=%ld, iova=0x%lx, mod=0x%lx",
+                bo->gem_handle, (long)bo->size, (long)bo->iova,
+                (unsigned long)modifier);
+
    tu_dump_bo_init(dev, bo);
 
    *out_bo = bo;
 
    return VK_SUCCESS;
 }
 
