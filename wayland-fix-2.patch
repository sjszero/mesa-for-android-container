    if (!submit)
       return NULL;
 
+   util_dynarray_init(&submit->commands, NULL);
+   util_dynarray_init(&submit->ranges, NULL);
+   util_dynarray_init(&submit->bind_cmds, NULL);
    return submit;
 }
 
