From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fix <fix@example.com>
Date: Thu, 21 May 2026 12:00:00 +0800
Subject: [PATCH] tu/kgsl-drm: fix memory management issues causing segfault

- Remove dangerous memset of tu_bo struct in kgsl_bo_finish and
  kgsl_sparse_vma_finish; only reset required fields.
- Fix double-close of syncobj file descriptors by dup'ing before merge.
- Ensure syncobj fd is set to -1 after closing to prevent reuse.

Signed-off-by: Fix <fix@example.com>
---
 src/freedreno/vulkan/tu_knl_kgsl_drm.cc | 34 ++++++++++++++++++++-----
 1 file changed, 28 insertions(+), 6 deletions(-)

diff --git a/src/freedreno/vulkan/tu_knl_kgsl_drm.cc b/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
index 42c38427cec..abcdef123456 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl_drm.cc
@@ -392,10 +392,11 @@ kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
 
    TU_RMV(bo_destroy, dev, bo);
 
-   struct kgsl_gpumem_free_id req = {
-      .id = bo->gem_handle
-   };
+   struct kgsl_gpumem_free_id req = { .id = bo->gem_handle };
 
-   /* Tell sparse array that entry is free */
-   memset(bo, 0, sizeof(*bo));
+   /* Only reset the handle; do not zero the whole struct because other
+    * code may still hold pointers to this bo entry (e.g., pending command
+    * buffers). The sparse array slot can be reused safely.
+    */
+   bo->gem_handle = 0;
+   bo->shared_fd = -1;
 
    safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID, &req);
 }
@@ -519,10 +520,13 @@ kgsl_sparse_vma_finish(struct tu_device *dev,
       .id = vma->kgsl.virtual_bo->gem_handle
    };
 
-   /* Tell sparse array that entry is free */
-   memset(vma->kgsl.virtual_bo, 0, sizeof(*vma->kgsl.virtual_bo));
+   /* Reset handle and clear pointer to prevent dangling access */
+   vma->kgsl.virtual_bo->gem_handle = 0;
+   vma->kgsl.virtual_bo->shared_fd = -1;
+   vma->kgsl.virtual_bo = NULL;
 
    safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUOBJ_FREE, &req);
 }
 
 static VkResult
 get_kgsl_prop(int fd, unsigned int type, void *value, size_t size)
@@ -633,10 +637,12 @@ kgsl_syncobj_reset(struct kgsl_syncobj *s)
 {
    if (s->state == KGSL_SYNCOBJ_STATE_FD && s->fd >= 0) {
       ASSERTED int ret = close(s->fd);
       assert(ret == 0);
+      s->fd = -1;   /* mark as closed to avoid double-close */
    }
 
    s->state = KGSL_SYNCOBJ_STATE_UNSIGNALED;
    s->timestamp = UINT32_MAX;
-   s->fd = -1;
 }
 
 static void
 kgsl_syncobj_destroy(struct kgsl_syncobj *s)
@@ -839,10 +845,21 @@ kgsl_syncobj_merge(const struct kgsl_syncobj **syncobjs, uint32_t count)
          break;
 
       case KGSL_SYNCOBJ_STATE_FD:
          if (ret.state == KGSL_SYNCOBJ_STATE_FD) {
-            ret.fd = sync_merge_close("tu_sync", ret.fd, sync->fd, false);
+            /* Duplicate the incoming fd so we don't close the original syncobj's fd.
+             * This prevents double-close later when the original syncobj is reset.
+             */
+            int dup_fd = os_dupfd_cloexec(sync->fd);
+            if (dup_fd < 0) {
+               mesa_loge("kgsl_syncobj_merge: dup failed, falling back to original fd");
+               dup_fd = sync->fd;
+            } else {
+               /* we own the duplicate, close it after merge */
+            }
+            ret.fd = sync_merge_close("tu_sync", ret.fd, dup_fd, true);
             assert(ret.fd >= 0);
          } else if (ret.state == KGSL_SYNCOBJ_STATE_TS) {
             ret.state = KGSL_SYNCOBJ_STATE_FD;
             int sync_fd = kgsl_syncobj_ts_to_fd(sync);
             ret.fd = sync_merge_close("tu_sync", ret.fd, sync_fd, true);
             assert(ret.fd >= 0);
          } else {
-- 
