From: Turnip Developer <turnip@example.com>
Date: 2026-06-07
Subject: [PATCH] tu/knl: fix multiple hidden issues in KGSL backend

Fix uninitialized dynarray, wrong size passed to bo_init_dmabuf,
resource leak, integer overflow, missing condition variable broadcast,
and other stability issues.

Signed-off-by: Turnip Developer <turnip@example.com>

diff --git a/tu_knl.cc b/tu_knl.cc
index 1234567..abcdefg 100644
--- a/tu_knl.cc
+++ b/tu_knl.cc
@@ -50,7 +50,9 @@ tu_bo_init_dmabuf(struct tu_device *dev,
                   int fd)
 {
    assert(!(flags & ~TU_BO_ALLOC_REPLAYABLE));
-   size = align64(size, os_page_size);
+   /* size == 0 means unknown, backend will fill actual size */
+   if (size)
+      size = align64(size, os_page_size);
    VkResult result = dev->instance->knl->bo_init_dmabuf(dev, bo, size, flags, fd);
    if (result != VK_SUCCESS)
       return result;
@@ -132,7 +134,10 @@ tu_bo_init_new_explicit_iova(struct tu_device *dev,
        * if the device supports cached-coherent memory type.
        */
-      mem_property =
-          dev->physical_device->memory.types[dev->physical_device->preferred_uncached_as_cached_index];
+      VkMemoryPropertyFlags cached_type =
+          dev->physical_device->memory.types[dev->physical_device->preferred_uncached_as_cached_index];
+      /* Only replace the relevant bits, keep other flags intact */
+      mem_property = (mem_property & ~replace_flags_mask) | cached_type;
    }
 
    VkResult result =
diff --git a/tu_knl_kgsl_drm.cc b/tu_knl_kgsl_drm.cc
index 7654321..zyxwvut 100644
--- a/tu_knl_kgsl_drm.cc
+++ b/tu_knl_kgsl_drm.cc
@@ -48,6 +48,7 @@ struct kgsl_syncobj
 {
    struct vk_object_base base;
    enum kgsl_syncobj_state state;
+   struct tu_device *device;   /* for condition variable broadcast */
 
    struct tu_queue *queue;
    uint32_t timestamp;
@@ -56,11 +57,18 @@ struct kgsl_syncobj
 };
 
 static void
-kgsl_syncobj_init(struct kgsl_syncobj *s, bool signaled)
+kgsl_syncobj_broadcast(struct tu_device *dev)
+{
+   pthread_mutex_lock(&dev->submit_mutex);
+   pthread_cond_broadcast(&dev->timeline_cond);
+   pthread_mutex_unlock(&dev->submit_mutex);
+}
+
+static void
+kgsl_syncobj_init(struct tu_device *dev, struct kgsl_syncobj *s, bool signaled)
 {
    s->state =
       signaled ? KGSL_SYNCOBJ_STATE_SIGNALED : KGSL_SYNCOBJ_STATE_UNSIGNALED;
-
+   s->device = dev;
    s->timestamp = UINT32_MAX;
    s->fd = -1;
 }
@@ -75,6 +83,10 @@ kgsl_syncobj_reset(struct kgsl_syncobj *s)
 
    s->state = KGSL_SYNCOBJ_STATE_UNSIGNALED;
    s->timestamp = UINT32_MAX;
    s->fd = -1;
+   /* No broadcast when resetting to unsignaled, because waiters need to
+    * stay blocked until it becomes signaled again.
+    */
 }
 
 static void
@@ -87,6 +99,8 @@ kgsl_syncobj_destroy(struct kgsl_syncobj *s)
 kgsl_syncobj_dup(struct kgsl_syncobj *s)
 {
    struct kgsl_syncobj dups = *s;
    if (s->state == KGSL_SYNCOBJ_STATE_FD && s->fd >= 0) {
       dups.fd = dup(s->fd);
+      if (dups.fd < 0)
+         dups.state = KGSL_SYNCOBJ_STATE_UNSIGNALED;
       assert(dups.fd >= 0);
    }
    return dups;
@@ -119,9 +133,8 @@ timestamp_to_fd(struct tu_queue *queue, uint32_t timestamp)
    return fd;
 }
 
 static int
 kgsl_syncobj_ts_to_fd(const struct kgsl_syncobj *syncobj)
 {
    assert(syncobj->state == KGSL_SYNCOBJ_STATE_TS);
    return timestamp_to_fd(syncobj->queue, syncobj->timestamp);
 }
@@ -179,7 +192,10 @@ static int
 get_relative_ms(uint64_t abs_timeout_ns)
 {
    if (abs_timeout_ns >= INT64_MAX)
       return -1;
 
-   uint64_t cur_time_ms = os_time_get_nano() / 1000000;
-   uint64_t abs_timeout_ms = abs_timeout_ns / 1000000;
+   int64_t cur_time_ms = os_time_get_nano() / 1000000;
+   int64_t abs_timeout_ms = abs_timeout_ns / 1000000;
    if (abs_timeout_ms <= cur_time_ms)
       return 0;
 
-   return abs_timeout_ms - cur_time_ms;
+   int64_t rel = abs_timeout_ms - cur_time_ms;
+   return rel > INT_MAX ? INT_MAX : (int)rel;
 }
 
 /* safe_ioctl is not enough as restarted waits would not adjust the timeout
@@ -219,6 +235,9 @@ kgsl_queue_wait_fence(struct tu_queue *queue, uint32_t fence,
 }
 
 static VkResult
 kgsl_syncobj_wait(struct tu_device *device,
                   struct kgsl_syncobj *s,
                   uint64_t abs_timeout_ns)
 {
    if (s->state == KGSL_SYNCOBJ_STATE_UNSIGNALED) {
       /* If this syncobj is unsignaled we need to wait for it to resolve to a
@@ -464,9 +483,8 @@ kgsl_syncobj_import(struct kgsl_syncobj *s, int fd)
    kgsl_syncobj_reset(s);
    if (fd >= 0) {
       s->state = KGSL_SYNCOBJ_STATE_FD;
       s->fd = fd;
    } else {
       s->state = KGSL_SYNCOBJ_STATE_SIGNALED;
    }
 
+   /* Wake up any threads waiting on this syncobj */
+   if (s->device)
+      kgsl_syncobj_broadcast(s->device);
+
    return VK_SUCCESS;
 }
 
 static int
@@ -532,6 +550,7 @@ kgsl_syncobj_merge(const struct kgsl_syncobj **syncobjs, uint32_t count)
 {
    struct kgsl_syncobj ret;
-   kgsl_syncobj_init(&ret, true);
+   /* Device pointer will be set by the caller (usually the first syncobj) */
+   kgsl_syncobj_init(NULL, &ret, true);
 
    if (count == 0)
       return ret;
@@ -551,6 +570,8 @@ kgsl_syncobj_merge(const struct kgsl_syncobj **syncobjs, uint32_t count)
                ret.timestamp = max_ts(ret.timestamp, sync->timestamp);
             } else {
                ret.state = KGSL_SYNCOBJ_STATE_FD;
+               if (!ret.device && sync->device)
+                  ret.device = sync->device;
                int sync_fd = kgsl_syncobj_ts_to_fd(sync);
                ret.fd = sync_merge_close("tu_sync", ret.fd, sync_fd, true);
                assert(ret.fd >= 0);
@@ -558,6 +579,8 @@ kgsl_syncobj_merge(const struct kgsl_syncobj **syncobjs, uint32_t count)
          } else if (ret.state == KGSL_SYNCOBJ_STATE_FD) {
+            if (!ret.device && sync->device)
+               ret.device = sync->device;
             int sync_fd = kgsl_syncobj_ts_to_fd(sync);
             ret.fd = sync_merge_close("tu_sync", ret.fd, sync_fd, true);
             assert(ret.fd >= 0);
@@ -569,6 +592,8 @@ kgsl_syncobj_merge(const struct kgsl_syncobj **syncobjs, uint32_t count)
       case KGSL_SYNCOBJ_STATE_FD:
          if (ret.state == KGSL_SYNCOBJ_STATE_FD) {
+            if (!ret.device && sync->device)
+               ret.device = sync->device;
             ret.fd = sync_merge_close("tu_sync", ret.fd, sync->fd, false);
             assert(ret.fd >= 0);
          } else if (ret.state == KGSL_SYNCOBJ_STATE_TS) {
@@ -580,6 +605,8 @@ kgsl_syncobj_merge(const struct kgsl_syncobj **syncobjs, uint32_t count)
             assert(ret.fd >= 0);
          } else {
             ret = *sync;
+            if (!ret.device && sync->device)
+               ret.device = sync->device;
             ret.fd = os_dupfd_cloexec(ret.fd);
             assert(ret.fd >= 0);
          }
@@ -593,9 +620,10 @@ struct vk_kgsl_syncobj
    struct kgsl_syncobj syncobj;
 };
 
 static VkResult
 vk_kgsl_sync_init(struct vk_device *device,
                   struct vk_sync *sync,
                   uint64_t initial_value)
 {
    struct vk_kgsl_syncobj *s = container_of(sync, struct vk_kgsl_syncobj, vk);
-   kgsl_syncobj_init(&s->syncobj, initial_value != 0);
+   struct tu_device *tu_dev = container_of(device, struct tu_device, vk);
+   kgsl_syncobj_init(tu_dev, &s->syncobj, initial_value != 0);
    return VK_SUCCESS;
 }
 
@@ -824,11 +852,14 @@ kgsl_queue_submit(struct tu_queue *queue, void *_submit,
       wait_semaphores[wait_count] = &last_submit_sync;
 
       struct kgsl_syncobj wait_sync =
          kgsl_syncobj_merge(wait_semaphores, wait_count + 1);
+      /* Inherit device pointer from one of the syncobjs (any) */
+      if (wait_sync.device == NULL && wait_count > 0)
+         wait_sync.device = wait_semaphores[0]->device;
       assert(wait_sync.state !=
              KGSL_SYNCOBJ_STATE_UNSIGNALED); // Would wait forever
 
       if (signal_count == 1) {
          /* Move instead of duplicating the syncobj, as we don't need to
           * keep the original one around.
@@ -846,8 +877,10 @@ kgsl_queue_submit(struct tu_queue *queue, void *_submit,
 
          kgsl_syncobj_destroy(&wait_sync);
       }
 
+      kgsl_syncobj_destroy(&wait_sync);
+
       kgsl_syncobj_destroy(&last_submit_sync);
 
       return VK_SUCCESS;
    }
@@ -977,8 +1010,12 @@ kgsl_queue_submit(struct tu_queue *queue, void *_submit,
       signal_sync = &container_of(signals[i].sync, struct vk_kgsl_syncobj, vk)->syncobj;
 
       kgsl_syncobj_reset(signal_sync);
       signal_sync->state = KGSL_SYNCOBJ_STATE_TS;
       signal_sync->queue = queue;
       signal_sync->timestamp = timestamp;
+      /* Wake up any threads waiting on this syncobj */
+      if (signal_sync->device)
+         kgsl_syncobj_broadcast(signal_sync->device);
    }
 
    if (u_trace_submission_data) {
@@ -1044,7 +1081,8 @@ kgsl_device_finish(struct tu_device *dev)
 static int
